DATABASE_URL="postgresql://user:password@localhost:5432/readthedocs_ai"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="readthedocs_ai"

# Required by the API routes and every script in scripts/. Use your own key —
# never commit a real value here or in .env.
OPENAI_API_KEY="..."

# Free-tier judge model for automatic answer evaluation. Get a key at
# https://aistudio.google.com/apikey. If unset, /api/ask still works —
# evaluation is just skipped (evaluation: null) rather than failing the
# request.
GEMINI_API_KEY="..."

# Optional. Number of chunks retrieved per question. Integer 1-50; falls
# back to the default of 5 (logged, not fatal) if unset or invalid.
# RAG_TOP_K=5

# Optional. If set, /api/documents, /api/ask, and /api/ask/recall require a
# matching x-app-password header. Leave unset for local dev.
# APP_ACCESS_PASSWORD=
